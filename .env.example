# GEMINI_API_KEY: Required for server-side Gemini AI triage calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# VITE_GOOGLE_MAPS_API_KEY: Optional Google Maps Platform JS/Routes/Places API key for interactive map & turn-by-turn routes.
VITE_GOOGLE_MAPS_API_KEY=""

# APP_URL: The hosted application URL injected at runtime.
APP_URL="MY_APP_URL"

# SESSION_SECRET: Secret string used to sign session tokens on the Express server.
SESSION_SECRET="change-me-in-production"
